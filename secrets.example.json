{
  "database": {
    "engine": "postgresql",
    "host": "your-db-host.internal",
    "port": 5432,
    "name": "artalay_ecommerce_db",
    "username": "your_db_username",
    "password": "your_db_password_here",
    "ssl_mode": "require",
    "connection_pool_size": 10,
    "connection_timeout_seconds": 15,
    "sqlite_storage_path": "backend/data/artalay.db",
    "use_local_sqlite_storage": true
  },
  "business_tier": {
    "environment": "production",
    "service_name": "ArtAlay-Ecommerce-BusinessTier",
    "version": "2.4.0",
    "api_host": "0.0.0.0",
    "api_port": 8000,
    "jwt_secret": "replace_with_strong_random_secret_token",
    "session_secret": "replace_with_strong_session_secret",
    "enable_audit_logging": true,
    "currency": "INR",
    "currency_symbol": "₹"
  },
  "third_party_secrets": {
    "razorpay_key_id": "your_razorpay_key_id",
    "razorpay_key_secret": "your_razorpay_key_secret",
    "delhivery_api_token": "your_delhivery_token",
    "whatsapp_business_token": "your_whatsapp_token"
  }
}
